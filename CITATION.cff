license: MIT
version: "0.1.6"
keywords:
  - GPU
  - Slurm
  - HPC
  - deep learning
  - training job failure
  - failure diagnosis
  - log classification
  - CUDA out of memory
  - NCCL
  - job monitoring
  - email notification
  - MLOps
